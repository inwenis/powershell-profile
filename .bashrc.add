# makes ESC key remove whole line
bind '"\e":kill-whole-line'

alias cg="pushd ~/git"
alias c="code ."

export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:~/go/bin

# add this to have a place to keep secrets
source ~/.bashrc.add.secrets

inwenis() {
    unset GITHUB_TOKEN
    gh auth switch -u inwenis
}
